{
  "expo": {
    "name": "OficiosYa",
    "slug": "oficiosya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oficiosya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E88E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oficiosya.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1E88E5"
      },
      "package": "com.oficiosya.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a OficiosYa acceder a tu ubicación para encontrar técnicos cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OficiosYa necesita acceso a tus fotos para actualizar tu perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
      },
      "extra": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://teelxokttmwlhumdiqwf.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRlZWx4b2t0dG13bGh1bWRpcXdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIyMjUyMDQsImV4cCI6MjA3NzgwMTIwNH0.NLG8gznap93N-box_yOO8l2yD27XWHHysGX6EpjzI_M"
      }
  }
}
